#!/usr/bin/env bash
# git pre-commit gate for the wiki: regenerate the board, then run the deterministic lint.
# Blocks the commit only on broken links, unresolved commit-gate tokens, or (if configured)
# initiative-schema violations; other advisory warnings pass.
# This is the wiki's OWN copy (installed by wiki-setup into <wiki>/hooks/), so a bare clone
# lints without the plugin present. Bypass once with: git commit --no-verify
# Lint the repo being committed (its toplevel), NOT a configured WIKI_ROOT: a plain-terminal
# commit has no plugin env vars set, and the gate must guard THIS repo, not default to ~/wiki.
set -uo pipefail
H="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KB="$(git rev-parse --show-toplevel)"

# Agent shells commit through wiki-commit, which uses a private index; a bare `git commit` in
# one takes whatever any session has staged. Opt-in via agent_commit_guard; the variables
# naming an agent shell come from agent_env_vars (default CLAUDECODE).
if [ "${WIKI_COMMIT:-}" != "1" ] && command -v python3 >/dev/null 2>&1; then
  guard=$(python3 - "$H" "$KB" <<'PY' 2>/dev/null || true
import os, sys
sys.path.insert(0, sys.argv[1])
import wikilib
cfg = wikilib.load_config(sys.argv[2])
if cfg.get("agent_commit_guard"):
    names = cfg.get("agent_env_vars") or ["CLAUDECODE"]
    print("block" if any(os.environ.get(n) for n in names) else "")
PY
)
  if [ "$guard" = "block" ]; then
    echo "wiki: commit from an agent shell refused; the shared index may hold another session's staging." >&2
    echo "Use: wiki-commit -m \"<message>\" <path>...   (or --all for everything dirty)" >&2
    exit 1
  fi
fi

# Regenerate before linting, so the lint (and the commit) sees a fresh board, not a stale
# one; --write is a no-op if STATE.md carries no board markers (e.g. a wiki that hasn't
# adopted the board yet).
if [ -f "$H/board.py" ] && command -v python3 >/dev/null 2>&1; then
  python3 "$H/board.py" "$KB" --write 2>/dev/null || true
  git -C "$KB" add STATE.md 2>/dev/null || true
fi

# WIKI_CHECK_INDEX: the initiative gate judges the staged version, so a page an
# auto-commit holds back does not block the files it does commit.
WIKI_CHECK_INDEX=1 "$H/lint.sh" "$KB"
