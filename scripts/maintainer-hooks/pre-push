#!/usr/bin/env bash
# Maintainer hook: every commit about to leave this machine, so an older offending commit fails
# even when the tip is clean.
scan="$(git rev-parse --show-toplevel)/scripts/check-no-org.sh"
zero=0000000000000000000000000000000000000000
rc=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then revs="$lsha --not --remotes"; else revs="$rsha..$lsha"; fi
  bash "$scan" --strict --range "$revs" || rc=1
done
exit "$rc"
