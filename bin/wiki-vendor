#!/usr/bin/env python3
"""wiki-vendor — the vendored file set, and its manifest.

A wiki keeps its own copy of the deterministic engine so a bare clone lints and searches
with no plugin installed. Nothing kept the two in step: the set to copy lived as prose in
the setup skill, so a new hook was vendored only if someone remembered, and a wiki could
run a months-old engine with no signal. Worse, copying only the files a wiki already had
left lint.sh calling scripts that were never delivered.

The set is derived here, once, and everything else reads the manifest.

    wiki-vendor --manifest            rewrite hooks/VENDOR.manifest from the working tree
    wiki-vendor --check               exit 1 if the manifest is stale (CI / tests)
    wiki-vendor --install WIKI_ROOT   copy the set into a wiki, manifest included

Ends with: VENDOR files=<n> version=<v> [STALE|OK|INSTALLED]
"""
import argparse
import hashlib
import json
import os
import shutil
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MANIFEST = os.path.join(ROOT, "hooks", "VENDOR.manifest")

# Lifecycle hooks run from the plugin path with plugin env set; they are never vendored.
# Everything else under hooks/ is engine, plus the CLIs a bare clone needs.
NOT_VENDORED = {"auto-commit.sh", "session-status.sh", "hooks.json", "VENDOR.manifest"}
BIN = ["wiki-query", "wiki-eval", "wiki-okf", "wiki-links"]


def version():
    try:
        with open(os.path.join(ROOT, ".claude-plugin", "plugin.json"), encoding="utf-8") as fh:
            return json.load(fh).get("version", "0")
    except (OSError, ValueError):
        return "0"


def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def vendored_set():
    out = []
    hooks = os.path.join(ROOT, "hooks")
    for name in sorted(os.listdir(hooks)):
        p = os.path.join(hooks, name)
        if os.path.isfile(p) and name not in NOT_VENDORED and not name.startswith("."):
            out.append(("hooks/" + name, p))
    for name in BIN:
        p = os.path.join(ROOT, "bin", name)
        if os.path.isfile(p):
            out.append(("bin/" + name, p))
    return out


def render():
    lines = [f"# generated by bin/wiki-vendor --manifest; do not hand-edit",
             f"version {version()}"]
    for rel, p in vendored_set():
        lines.append(f"{sha(p)}  {rel}")
    return "\n".join(lines) + "\n"


def main():
    ap = argparse.ArgumentParser(add_help=True)
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--manifest", action="store_true")
    g.add_argument("--check", action="store_true")
    g.add_argument("--install", metavar="WIKI_ROOT")
    a = ap.parse_args()
    want = render()
    n = len(vendored_set())

    if a.manifest:
        with open(MANIFEST, "w", encoding="utf-8") as fh:
            fh.write(want)
        print(f"VENDOR files={n} version={version()} OK")
        return 0

    if a.check:
        have = open(MANIFEST, encoding="utf-8").read() if os.path.exists(MANIFEST) else ""
        if have != want:
            print("VENDOR manifest is stale; run: bin/wiki-vendor --manifest", file=sys.stderr)
            print(f"VENDOR files={n} version={version()} STALE")
            return 1
        print(f"VENDOR files={n} version={version()} OK")
        return 0

    kb = os.path.expanduser(a.install)
    if not os.path.isdir(kb):
        print(f"wiki-vendor: no such wiki root: {kb}", file=sys.stderr)
        return 2
    for sub in ("hooks", "bin"):
        os.makedirs(os.path.join(kb, sub), exist_ok=True)
    for rel, p in vendored_set():
        dst = os.path.join(kb, rel)
        shutil.copy2(p, dst)
    with open(os.path.join(kb, "hooks", "VENDOR.manifest"), "w", encoding="utf-8") as fh:
        fh.write(want)
    print(f"VENDOR files={n} version={version()} INSTALLED")
    return 0


if __name__ == "__main__":
    sys.exit(main())
